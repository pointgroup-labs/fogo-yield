{
  "name": "@ignitionfi/fogo-yield-sdk",
  "type": "module",
  "version": "2.1.0",
  "description": "Fogo Yield SDK",
  "contributors": [
    "Ignition Team (https://ignitionfi.xyz/)"
  ],
  "homepage": "https://ignitionfi.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/pointgroup-labs/fogo-yield.git"
  },
  "keywords": [],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.1.2",
    "@noble/hashes": "^2.2.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsdown": "catalog:",
    "typescript": "^6.0.3"
  }
}
